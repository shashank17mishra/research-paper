# ==============================================================================
# Daily Tech Intelligence - Environment Configuration
# ==============================================================================
# NOTE: NO API KEYS ARE REQUIRED. The system operates 100% autonomously at ₹0/month
# using public academic APIs (arXiv) and built-in natural language processing.
#
# All parameters below are strictly OPTIONAL enhancements.
# ==============================================================================

# Dry Run Mode (True to test pipeline without committing or writing persistence)
DRY_RUN=false

# Optional: Override maximum papers per execution
PAPERS_PER_DAY=10

# Optional: Enable verbose debug logging (DEBUG / INFO / WARNING)
LOG_LEVEL=INFO

# Optional AI API Fallback / Enhancer (Strictly optional: system operates with full quality without this)
# If provided, free tier APIs can optionally augment extractive summaries.
# HF_TOKEN=
# GEMINI_API_KEY=
